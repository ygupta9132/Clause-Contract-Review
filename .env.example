# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Clerk - https://dashboard.clerk.com -> your app -> API keys
# ---------------------------------------------------------------------------
# Left blank on purpose. Copy both values straight from the Clerk dashboard.
#
# No dummy value is written here: GitHub's secret scanning reads the usual Clerk-style
# placeholder as a Stripe test key and blocks the push. A placeholder that trips a scanner is
# worse than no placeholder at all.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people. These match the routes in app/(auth).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/contracts
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/contracts

# ---------------------------------------------------------------------------
# Model provider. Both speak the OpenAI chat-completions and embeddings shape,
# so switching is one line here.
#
#   openrouter - what the task suggests. Free models, but the account is capped
#                at 50 :free requests per DAY until it holds $10 of credits.
#                One contract costs about 11 requests, so that is ~4 a day.
#   gemini     - Google AI Studio (https://aistudio.google.com/apikey). Free,
#                no card, a much larger daily allowance. Used while building,
#                for exactly that reason.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter

# Optional. Tried once when the chosen chat model is rate-limited or keeps
# returning nothing. Leave empty to never spend money. Example: openai/gpt-4o-mini
LLM_FALLBACK_CHAT_MODEL=

# --- openrouter ------------------------------------------------------------
# Check the current free list at https://openrouter.ai/models (search "free")
# before you start: free model ids change.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free

# --- gemini (Google AI Studio) ---------------------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Must match the chosen embedding model's output size, measured rather than assumed:
#   nemotron-3.5-embed-1b (openrouter) = 2048
# db:push rebuilds the embedding column when this changes, which deletes existing chunks.
# Changing this means re-running db:push and re-embedding existing contracts.
EMBEDDING_DIMENSIONS=2048

# Gap between checklist items, in milliseconds. Eight calls fired back to back trip the free
# tier's per-minute cap, which it signals with an empty body rather than a 429.
REVIEW_ITEM_DELAY_MS=1000

# Optional: sent to OpenRouter for their dashboard attribution.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Contract Review Assistant

# ---------------------------------------------------------------------------
# Infrastructure. These defaults match docker-compose.yml.
# Running the app outside Docker? Use localhost instead of the service names:
#   DATABASE_URL=postgres://contract:contract@localhost:5433/contract_review
#   REDIS_URL=redis://localhost:6380
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://contract:contract@postgres:5432/contract_review
REDIS_URL=redis://redis:6379

# Where uploaded files are written. A docker volume is mounted here.
UPLOAD_DIR=/data/uploads

# Hard limit enforced on upload, in bytes. 20 MB.
MAX_UPLOAD_BYTES=20971520
